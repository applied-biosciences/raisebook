# Wasila production stack (deploy/docker-compose.yml). Copy to deploy/.env and fill in.
# deploy/.env is git-ignored. Never commit real secrets.

# --- Hosts (DNS must point here before `up`; Caddy fetches TLS certificates itself) ---
# Self-hosting: replace both with your own hosts, and the cookie domain and EMAIL_FROM below.
WEB_HOST=wasila.app
API_HOST=api.wasila.app

# --- Postgres ---
POSTGRES_USER=wasila
POSTGRES_DB=wasila
# Generate: openssl rand -base64 36 | tr -d '/+=' | cut -c1-40
POSTGRES_PASSWORD=

# --- API ---
WASILA_ENVIRONMENT=production
# Signs session cookies and CSRF tokens. Generate:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out.
WASILA_SESSION_SECRET=
# Parent domain shared by the web and API hosts (so the browser sends the session cookie to both).
WASILA_SESSION_COOKIE_DOMAIN=wasila.app
# Extra allowed browser origins, comma-separated or a JSON list, e.g. https://staging.example.com
# (the web host is always allowed). Empty or [] means none.
WASILA_CORS_ORIGINS=[]
WASILA_DB_POOL_SIZE=5
WASILA_RATE_LIMIT_BACKEND=postgres
# Anti-abuse cap on companies (workspaces) one person can own; listed emails have no cap.
WASILA_MAX_WORKSPACES_PER_USER=10
WASILA_WORKSPACE_LIMIT_EXEMPT_EMAILS=
WASILA_LOG_LEVEL=INFO
# Sign-in links per client IP per hour (empty = 100). People on one conference or office
# Wi-Fi share an IP: raise it (for example 300) for an event.
WASILA_MAGIC_LINKS_PER_IP_HOUR=
# All outbound email per hour across the server (empty = 500). Keep it under your email
# provider's plan so a burst cannot use up the quota and block every sign-in.
WASILA_EMAIL_GLOBAL_PER_HOUR=

# --- AI research (off by default; docs/DEPLOY.md "AI research") ---
# Investor research runs on each workspace's own OpenRouter key, in the `worker` service.
# Off: the research routes, the 5 research MCP tools and the research UI are hidden.
WASILA_RESEARCH_ENABLED=false
# Key-encryption key that seals the saved OpenRouter keys. Required when research is on;
# generate it once and keep it in the password manager next to this file (losing it means
# every workspace enters its OpenRouter key again):
#   docker compose -f deploy/docker-compose.yml run --rm --no-deps api wasilactl secrets gen-kek
#   (or: python3 -c "import base64,os; print('k1:' + base64.urlsafe_b64encode(os.urandom(32)).decode())")
WASILA_SECRETS_KEK=
# Only while rotating: the old KEK goes here, a new one (new id, e.g. k2) above, restart,
# then `wasilactl secrets rotate`, then empty this again.
WASILA_SECRETS_KEK_PREVIOUS=
# Gets an email when someone confirms a research removal request (empty = a log line only).
WASILA_OPERATOR_EMAIL=
# Background jobs run at once per worker container (1-32).
WASILA_WORKER_CONCURRENCY=4

# --- "Continue with Google" sign-in (optional) ---
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type "Web application".
# Authorized redirect URI (exactly): https://API_HOST/v1/auth/google/callback
#   (production: https://api.wasila.app/v1/auth/google/callback)
# Leave both empty to turn the feature off; the sign-in page then hides the button.
WASILA_GOOGLE_CLIENT_ID=
WASILA_GOOGLE_CLIENT_SECRET=

# --- Email (magic links and invites) ---
# Any SMTP provider (Postmark, Amazon SES, Resend, Mailgun…). The sending domain needs the
# provider's SPF/DKIM records; see docs/DEPLOY.md.
WASILA_EMAIL_BACKEND=smtp
WASILA_EMAIL_FROM="Wasila <login@wasila.app>"
WASILA_SMTP_HOST=
WASILA_SMTP_PORT=587
WASILA_SMTP_USERNAME=
WASILA_SMTP_PASSWORD=
WASILA_SMTP_STARTTLS=true

# --- Web (baked into the web image at build time; rebuild after changing) ---
NEXT_PUBLIC_REPO_URL=https://github.com/applied-biosciences/wasila
# Empty hides every "Support Wasila" button. Set it once the sponsor page is live,
# e.g. https://github.com/sponsors/gumruyanzh
NEXT_PUBLIC_SPONSOR_URL=

# --- Backups (deploy/backup.sh) ---
# Local dumps older than this are deleted. The privacy page promises at most 14 days.
BACKUP_DIR=/var/backups/wasila
BACKUP_RETENTION_DAYS=14
