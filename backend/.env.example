# Wasila API settings (copy to backend/.env for local development). SPEC §10.
# Every variable is optional locally; staging/production need WASILA_SESSION_SECRET.

WASILA_ENV=dev                      # development | test | staging | production (dev/prod accepted)
WASILA_DATABASE_URL=postgresql://localhost/wasila_dev
# WASILA_DB_SCHEMA=                 # search_path override (tests use one schema per run)
# WASILA_DB_POOL_SIZE=5

WASILA_PUBLIC_BASE_URL=http://localhost:8000   # this API (a localhost host enables dev_link)
WASILA_APP_URL=http://localhost:3000           # the web app (magic links point here)
# WASILA_CORS_ORIGINS=http://127.0.0.1:3000    # extra allowed origins, comma-separated

# Sessions. Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# WASILA_SESSION_SECRET=
WASILA_SESSION_COOKIE_SECURE=false  # true in production (HTTPS)
# WASILA_SESSION_COOKIE_DOMAIN=wasila.app   # production: shared by web and api hosts
# WASILA_SESSION_TTL_HOURS=720
# WASILA_MAGIC_LINK_TTL_MINUTES=15

# Email: log (dev prints sign-in links to stdout) | smtp | memory (tests)
WASILA_EMAIL_BACKEND=log
# WASILA_EMAIL_FROM=Wasila <login@wasila.app>
# WASILA_SMTP_HOST=
# WASILA_SMTP_PORT=587
# WASILA_SMTP_USERNAME=
# WASILA_SMTP_PASSWORD=
# WASILA_SMTP_STARTTLS=true

# Rate limits: postgres (default, works across replicas) | memory | off
WASILA_RATE_LIMIT_BACKEND=postgres

WASILA_LOG_LEVEL=INFO
WASILA_LOG_JSON=false               # true in production

# Tests
# WASILA_TEST_DATABASE_URL=postgresql://localhost/wasila_test
# WASILA_TEST_KEEP_SCHEMA=1
